    "@typescript-eslint/parser": "^6.0.0",
    "prisma": "^5.0.0",
    "ts-loader": "^9.4.3",
    "ts-node": "^10.9.1",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.1.3"
